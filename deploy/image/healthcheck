#!/bin/sh
# Passes when every started long running service is up (s6-svstat) and, if started, Faye's
# port and Hydra's admin health answer. Services FAYE_SERVICES / FAYE_DEMO left out still have
# a directory under /run/service, so the started set comes from s6-rc.
active=" $(s6-rc -a list | tr '\n' ' ') "
started() { case "$active" in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
fail=0
for s in hydra faye login admin ip-reputation demo-client; do
  if started "$s" && ! s6-svstat "/run/service/$s" 2>/dev/null | grep -q '^up '; then
    echo "$s is not up"
    fail=1
  fi
done
if started faye && ! nc -z 127.0.0.1 8080; then
  echo "faye is not answering on :8080"
  fail=1
fi
if started hydra && ! wget -q -O /dev/null "http://127.0.0.1:4445/health/ready"; then
  echo "hydra is not ready"
  fail=1
fi
exit $fail
