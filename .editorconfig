root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java and Gradle Kotlin scripts: enforced by Spotless in `./gradlew build` (ADR 0003)
[*.{java,kt,kts}]
indent_size = 4
max_line_length = 120

[*.xml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{gradlew,*.sh}]
end_of_line = lf

[*.bat]
end_of_line = crlf
