.gradle/
server/gradle/wrapper/gradle-wrapper.jar
build/
out/
.idea/
*.iml
.DS_Store
deploy/.bin/
# SQLite databases (faye.db, and the WAL files beside it) made by local runs
*.db
*.db-wal
