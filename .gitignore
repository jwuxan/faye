.gradle/
src/gradle/wrapper/gradle-wrapper.jar
apps/server/gradle/wrapper/gradle-wrapper.jar
build/
out/
.idea/
*.iml
.DS_Store
deploy/.bin/
# SQLite databases (faye.db, and the WAL files beside it) made by local runs
*.db
*.db-wal
*.db-shm
deploy/.data/

# Redis dumps (Redis is gone since ADR 0017; never commit binaries)
*.rdb

# Fuzzing (ADR 0007): the generated corpus and raw crash files stay out of the repo; a finding is
# committed only as a readable regression input
.cifuzz-corpus/
crash-*
timeout-*
slow-unit-*
oom-*

# brand/generate.py: the downloaded font and the script's virtualenv
brand/.cache/
brand/.venv/
__pycache__/

# Browser tests of the Login UI: the browser Playwright downloads (pinned by its version), and its output
apps/web/apps/login/.playwright/
apps/web/apps/login/test-results/
apps/web/apps/login/playwright-report/
