["flow", 1, "forms", 1,
  ["entry", "login", "authenticate",
    ["seq",
      ["set", "risk", "high"],
      ["step", "identify", ["seq", ["screen", "identifier"], ["call", "identity.resolve"]]],
      ["step", "credential",
        ["choose",
          [["opt", "password",
             ["retry", 2, ["seq", ["screen", "password"], ["call", "password.verify"]]]],
            ["opt", "totp",
              ["seq", ["screen", "otp"], ["call", "totp.verify"]],
              {"guard": "user.has_totp"}],
            ["opt", "low-risk", ["fail", "unreachable"], {"guard": {"eq": ["vars.risk", "low"]}}]]]],
      ["step", "nothing-left",
        ["choose",
          [["opt", "never", ["succeed"], {"guard": {"exists": "user.no_such_field"}}],
            ["opt", "done", ["succeed"], {"guard": {"gt": ["user.attempts", 0]}}]]]],
      ["succeed"]]]]
