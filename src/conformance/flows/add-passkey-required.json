["flow", 1, "add-passkey-required", 1,
  ["entry", "login", "authenticate",
    ["seq",
      ["step", "identify", ["seq", ["screen", "identifier"], ["call", "identity.resolve"]]],
      ["step", "credential",
        ["retry", 3, ["seq", ["screen", "password"], ["call", "password.verify"]]]],
      ["step", "add-passkey",
        ["when",
          {"not": "user.has_passkey"},
          ["seq", ["screen", "passkey", {"register": true, "required": true}], ["call", "webauthn.register"]]]],
      ["succeed"]]]]
