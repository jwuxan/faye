(flow 1 passkey-totp 1
  (entry login authenticate
    (seq
      (step identify (seq (screen identifier {:passkey true}) (call identity.resolve)))
      (step credential
        (choose
          ((opt passkey
              (seq (screen passkey) (call webauthn.assert))
              {:guard {:eq (user.identified_by passkey)}})
            (opt password
              (retry 3 (seq (screen password) (call password.verify)))
              {:guard {:eq (user.identified_by identifier)}}))))
      (step second-factor
        (when
          {:and ({:ne (auth.acr faye:2fa)}
                  {:or (user.has_totp user.mfa_required {:has (host.acr_values faye:2fa)})})}
          (choose
            ((opt totp (retry 3 (seq (screen otp) (call totp.verify))) {:guard user.has_totp})
              (opt passkey
                (seq (screen passkey) (call webauthn.assert))
                {:guard {:and (user.has_passkey {:not {:has (auth.amr hwk)}})}})
              (opt enroll
                (retry 3 (seq (screen otp_enroll) (call totp.enroll)))
                {:guard {:not {:or (user.has_totp user.has_passkey)}}})))))
      (step add-passkey
        (when
          {:and ({:not user.has_passkey} {:eq (auth.acr faye:2fa)})}
          (seq (screen passkey {:register true}) (call webauthn.register))))
      (succeed)))
  (entry consent consent
    (seq
      (step grant (when {:not client.first_party} (seq (screen consent) (call consent.record))))
      (succeed))))
