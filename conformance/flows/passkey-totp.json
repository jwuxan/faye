["flow", "passkey-totp", 1,
  ["login",
    ["seq",
      ["step", "identify", ["seq", ["screen", "identifier", {"passkey": true}], ["call", "identity.resolve"]]],
      ["step", "credential",
        ["choose",
          ["opt", "passkey",
            ["when", {"eq": ["user.identified_by", "passkey"]},
              ["seq", ["screen", "passkey"], ["call", "webauthn.assert"]]]],
          ["opt", "password",
            ["when", {"eq": ["user.identified_by", "identifier"]},
              ["retry", 3, ["seq", ["screen", "password"], ["call", "password.verify"]]]]]]],
      ["step", "second-factor",
        ["when",
          {"and": [
            {"ne": ["auth.acr", "faye:2fa"]},
            {"or": ["user.has_totp", "user.mfa_required", {"has": ["hydra.acr_values", "faye:2fa"]}]}]},
          ["choose",
            ["opt", "totp",
              ["when", "user.has_totp",
                ["retry", 3, ["seq", ["screen", "otp"], ["call", "totp.verify"]]]]],
            ["opt", "passkey",
              ["when", {"and": ["user.has_passkey", {"not": {"has": ["auth.amr", "hwk"]}}]},
                ["seq", ["screen", "passkey"], ["call", "webauthn.assert"]]]],
            ["opt", "enroll",
              ["when", {"not": {"or": ["user.has_totp", "user.has_passkey"]}},
                ["retry", 3, ["seq", ["screen", "otp_enroll"], ["call", "totp.enroll"]]]]]]]],
      ["step", "add-passkey",
        ["when", {"and": [{"not": "user.has_passkey"}, {"eq": ["auth.acr", "faye:2fa"]}]},
          ["seq", ["screen", "passkey", {"register": true}], ["call", "webauthn.register"]]]],
      ["succeed"]]]]
