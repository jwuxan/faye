["flow", "forms", 1,
  ["login",
    ["seq",
      ["set", "risk", "high"],
      ["step", "identify", ["seq", ["screen", "identifier"], ["call", "identity.resolve"]]],
      ["step", "credential",
        ["choose",
          ["opt", "password", ["retry", 2, ["seq", ["screen", "password"], ["call", "password.verify"]]]],
          ["opt", "totp", ["when", "user.has_totp", ["seq", ["screen", "otp"], ["call", "totp.verify"]]]],
          ["opt", "low-risk", ["when", {"eq": ["vars.risk", "low"]}, ["fail", "unreachable"]]]]],
      ["step", "nothing-left",
        ["choose",
          ["opt", "never", ["when", {"exists": "user.no_such_field"}, ["succeed"]]],
          ["opt", "done", ["when", {"gt": ["user.attempts", 0]}, ["succeed"]]]]],
      ["succeed"]]]]
