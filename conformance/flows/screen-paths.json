["flow", 1, "screen-paths", 1,
  ["entry", "login", "authenticate",
    ["seq",
      ["step", "identify", ["seq", ["screen", "identifier"], ["call", "identity.resolve"]]],
      ["step", "credential",
        ["choose",
          [["opt", "password",
             ["retry", 2, ["seq", ["screen", "password", {"path": "/challenge/password"}], ["call", "password.verify"]]]],
            ["opt", "totp",
              ["seq", ["screen", "otp", {"path": "/challenge/mfa/totp"}], ["call", "totp.verify"]],
              {"guard": "user.has_totp"}]]]],
      ["succeed"]]],
  ["entry", "consent", "consent",
    ["seq",
      ["step", "grant", ["seq", ["screen", "consent"], ["call", "consent.record"]]],
      ["succeed"]]]]
